<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>false</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>L1CacheSystem</PackageId>
		<PackageVersion>11.0.0.1</PackageVersion>
		<Authors>Brevnov Vyacheslav Sergeevich</Authors>
		<RepositoryUrl>https://github.com/SoftStoneDevelop/L1CacheSystem</RepositoryUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<Description>L1-level cache system for organizing a cache within an application.</Description>
		<PackageTags>cache, l1cachesystem, analysis, generator</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup Label="not net11.0 specific" Condition="'$(TargetFramework)' != 'net11.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
	</ItemGroup>
	<ItemGroup Label="net11.0 specific" Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="L1CacheSystem.Tests" />
	</ItemGroup>
</Project>
