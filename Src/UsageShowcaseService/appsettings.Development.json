{
  "AllowedHosts": "*",
  "AppSettings": {
    "RestIP": "127.0.0.1",
    "RestPort": 80
  },
  "MetricSettings": {
    "RestIP": "127.0.0.1",
    "RestPort": 80
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "Logs\\log.txt" }
      }
    ]
  }
}